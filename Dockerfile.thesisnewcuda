FROM nvidia/cuda:12.6.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y \
    locales \
    curl \
    gnupg2 \
    lsb-release \
    software-properties-common \
    git \
    build-essential \
    cmake \
    wget \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    python3-setuptools \
    libgl1 \
    libglib2.0-0 \
    libboost-system-dev \
    libboost-program-options-dev \
    libeigen3-dev \
    pybind11-dev \
    && rm -rf /var/lib/apt/lists/*

RUN locale-gen en_US en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

RUN add-apt-repository universe

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu jammy main" \
    > /etc/apt/sources.list.d/ros2.list

RUN apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-cv-bridge \
    ros-humble-sensor-msgs \
    ros-humble-geometry-msgs \
    ros-humble-image-transport \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init || true && rosdep update

RUN python3 -m venv --system-site-packages /opt/thesis-venv
ENV PATH="/opt/thesis-venv/bin:${PATH}"

RUN pip install --upgrade pip setuptools wheel

RUN pip install \
    ninja \
    scipy \
    scikit-image \
    matplotlib \
    omegaconf \
    trimesh \
    kornia \
    open3d \
    warp-lang \
    ruamel.yaml \
    transformations \
    hydra-core \
    iopath \
    opencv-python \
    h5py \
    transformers

RUN pip install \
    torch==2.7.0 \
    torchvision==0.22.0 \
    torchaudio==2.7.0 \
    --index-url https://download.pytorch.org/whl/cu126

# nvdiffrast and pytorch3d compile CUDA extensions against the torch build
# above, so they must come after it. Both come from source (no PyPI releases
# track current torch/CUDA combos in time), hence --no-build-isolation so the
# build sees the already-installed torch instead of a fresh isolated env.
RUN pip install --no-cache-dir --no-build-isolation \
    git+https://github.com/NVlabs/nvdiffrast.git

RUN pip install --no-cache-dir --no-build-isolation \
    "git+https://github.com/facebookresearch/pytorch3d.git@stable"

RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "source /opt/thesis-venv/bin/activate" >> /root/.bashrc

RUN echo 'if [ -f /workspace/MasterThesis/install/setup.bash ]; then source /workspace/MasterThesis/install/setup.bash; fi' >> /root/.bashrc

WORKDIR /workspace/MasterThesis
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Value: true
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 10
      Cell Size: 0.1
      Value: true
  Global Options:
    Fixed Frame: lbr_one_link_7
    Frame Rate: 30
  Value: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Current Tool: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.05
      Pitch: 0.3
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 40
